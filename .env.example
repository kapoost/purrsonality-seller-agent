# Skopiuj ten plik jako .env.local i podmień wartości po `=`.
# .env.local jest gitignored — bezpieczne miejsce na sekrety.

# --- Required ---

# HTTP port serwera. Cloud Run: ustawia automatycznie na 8080 (PORT env).
PORT=3001

# Admin stats dashboard port. Domyślnie PORT+1 (lokalnie 3002, na Fly 8081).
# Endpoints:
#   GET /            — HTML dashboard (open w przeglądarce)
#   GET /api/info    — agent metadata (no auth)
#   GET /api/metrics — counters + latencies (Bearer ADCP_AUTH_TOKEN)
# Na Fly NIE eksponowany przez http_service — dostęp przez:
#   flyctl proxy 8081:8081 -a purrsonality-seller
# Lokalnie: dodaj override jeśli Docker zajmuje 3002 (typowy konflikt).
ADMIN_PORT=3002

# Bearer token dla buyer agents (verifyApiKey). Wygeneruj losowy:
#   openssl rand -hex 32 | pbcopy
# Compliance runner używa osobno `demo-acme-outdoor-v1` (hardcoded w index.ts).
ADCP_AUTH_TOKEN=changeme_generate_with_openssl_rand_hex_32

# Public base URL agenta. W rozwoju lokalnym = http://127.0.0.1:PORT.
# Na production = https://<your-domain> (Cloud Run URL lub custom).
PUBLIC_BASE_URL=http://127.0.0.1:3001

# --- Postgres (opcjonalne — fallback do in-memory jeśli brak) ---

# Neon connection string. Z dashboardu Neon (Connection Details → Pooled).
# Format: postgresql://USER:PASS@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Jeśli brak — server używa in-memory (dev mode, restart = data loss).
DATABASE_URL=

# --- Future signing (gdy F4 unblocked po #1886) ---

# Ed25519 private JWK dla outbound webhook signing.
# Format: {"kty":"OKP","crv":"Ed25519","d":"...","x":"...","adcp_use":"webhook-signing"}
# Cats keypair `purr-20260518` NIE pasuje (różny adcp_use); mint nowy.
ADCP_PRIVATE_JWK=
ADCP_KEY_ID=

# --- Runtime config ---

# 'development' (default), 'test', lub 'production'. Production aktywuje
# explicit-store enforcement w SDK — wszystkie persistence MUSI być wired
# (Postgres above), in-memory crash na boot.
NODE_ENV=development

# Ustawiaj na '1' żeby comply_test_controller był aktywny na lokalnym deploy.
# W production NIE ustawiaj — gate domyślnie deny live caller.
ADCP_SANDBOX=1
